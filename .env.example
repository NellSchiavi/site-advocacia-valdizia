APP_NAME="Dra. Valdizia Melo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados — em desenvolvimento local (Docker/Sail) os valores abaixo
# já correspondem aos serviços definidos em compose.yaml. Em homologação/
# produção, substituir por host/credenciais reais do ambiente via .env
# (nunca versionar o .env real).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=valdizia_melo
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Painel administrativo (Fase 4A): em produção, com HTTPS, defina
# SESSION_SECURE_COOKIE=true para que o cookie de sessão só seja enviado por
# conexão segura. Deixado sem valor aqui de propósito — em desenvolvimento
# local (http://localhost) um cookie "secure" nunca seria enviado pelo
# navegador, o que quebraria o login. Ver PLANO-TECNICO.md / preparação de
# produção (Locaweb) antes de fixar este valor globalmente.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# E-mail — em desenvolvimento local usa o Mailpit (captura tudo, não envia de
# verdade; UI em http://localhost:8025). Em produção, trocar para o provedor
# transacional recomendado no PLANO-TECNICO.md (Resend) — nunca usar a senha
# da conta de e-mail pessoal da cliente.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@valdiziamelo.adv.br"
MAIL_FROM_NAME="${APP_NAME}"

# Preencher em produção (não commitar valores reais):
# MAIL_MAILER=resend
# RESEND_KEY=
NOTIFICATION_EMAIL=adv.valdizia@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sail (desenvolvimento local) — UID/GID do usuário do host, evita problemas
# de permissão de arquivo entre o container e a máquina do desenvolvedor.
WWWUSER=1000
WWWGROUP=1000
